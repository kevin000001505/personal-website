{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Portfolio Analytics — Recruiter Behavior",
  "uid": "portfolio-analytics",
  "tags": ["portfolio", "analytics", "loki"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Loki",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "session",
        "type": "query",
        "label": "Session (optional filter)",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": { "label": "session_id", "stream": "{container=\"fastapi\"}", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Sessions",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "count(sum by (session_id) (count_over_time({container=\"fastapi\", event=\"analytics_session_end\"} [$__range])))",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg Time on Page",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "avg_over_time({container=\"fastapi\", event=\"analytics_session_end\"} | json | unwrap duration_s [$__range])",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reached 100% Scroll",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_session_end\"} | json | max_scroll_pct >= 100 [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Chat Opens",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_chat_open\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Scroll Depth Funnel",
      "description": "How far visitors scroll — shows dropoff",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "≥25%",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_session_end\"} | json | max_scroll_pct >= 25 [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "legendFormat": "≥50%",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_session_end\"} | json | max_scroll_pct >= 50 [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "legendFormat": "≥75%",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_session_end\"} | json | max_scroll_pct >= 75 [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "D",
          "legendFormat": "100%",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_session_end\"} | json | max_scroll_pct >= 100 [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Section Dwell Time (total seconds)",
      "description": "How long visitors actually looked at each section",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{section_id}}",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (section_id) (sum_over_time({container=\"fastapi\", event=\"analytics_section_dwell\"} | json | unwrap dwell_ms [$__range])) / 1000",
          "queryType": "instant"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "displayMode": "hidden", "placement": "bottom", "showLegend": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Project Clicks (which project drew them in)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{project_name}}",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (project_name) (count_over_time({container=\"fastapi\", event=\"analytics_project_click\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "displayMode": "hidden", "showLegend": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Project Attention (view time in seconds, no click needed)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{project_name}}",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (project_name) (sum_over_time({container=\"fastapi\", event=\"analytics_project_view\"} | json | unwrap dwell_ms [$__range])) / 1000",
          "queryType": "instant"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "displayMode": "hidden", "showLegend": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-YlBl" },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "What Recruiters Ask Kermit",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{chip_label}}",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (chip_label) (count_over_time({container=\"fastapi\", event=\"analytics_ask_chip_click\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true, "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Navigation Jumps (nav menu → section)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{target_section}}",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (target_section) (count_over_time({container=\"fastapi\", event=\"analytics_nav_click\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "displayMode": "hidden", "showLegend": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Copy Events",
      "description": "Someone copied text — email/phone = hot lead",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_text_copy\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Chat Messages Sent",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_chat_message\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Sessions Over Time",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "sessions",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_session_end\"} [$__interval]))",
          "queryType": "range"
        },
        {
          "refId": "B",
          "legendFormat": "chat opens",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_chat_open\"} [$__interval]))",
          "queryType": "range"
        },
        {
          "refId": "C",
          "legendFormat": "project clicks",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({container=\"fastapi\", event=\"analytics_project_click\"} [$__interval]))",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "barAlignment": 0,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Link & External Link Clicks",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{container=\"fastapi\", event=~\"analytics_link_click|analytics_project_click\"} | json | line_format \"[{{.event_type}}] {{.link_text}}{{.project_name}} → {{.href}}  (from section: {{.section_id}})\"",
          "queryType": "range"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Live Event Stream (every tracked interaction)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 46 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{container=\"fastapi\"} |~ \"analytics_\" | json | session_id=~\"$session\" | line_format \"[{{.event_type}}] session={{.session_id}} ip={{.client_ip}}  {{.section_id}}{{.project_name}}{{.link_text}}{{.chip_label}}{{.target_section}}  dwell={{.dwell_ms}}ms  scroll={{.scroll_pct}}%  duration={{.duration_s}}s\"",
          "queryType": "range"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
